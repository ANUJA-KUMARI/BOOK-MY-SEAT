# Copy this file to ".env" and adjust. ".env" is ignored by Git and must never be committed.
NODE_ENV=development
PORT=3000

# --- MySQL (Phase 4) -------------------------------------------------------------------------------
# Use 127.0.0.1 (not "localhost"): it avoids IPv6 lookup problems on Windows.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_my_seat
# Use the dedicated least-privilege user "bms_app" (see database/create_app_user.sql). Never use root.
DB_USER=bms_app
# Put the password you chose for bms_app here, in your own ".env" file ONLY. Never in this example file.
# If it contains a # character, wrap it in double quotes, for example:  DB_PASSWORD="my#password"
DB_PASSWORD=
# Maximum number of MySQL connections the pool may open (1 to 100).
DB_CONNECTION_LIMIT=10
# Managed MySQL providers should use TLS. Set true and provide the provider CA certificate if required.
DB_SSL=false
# Optional PEM CA certificate supplied by your managed MySQL provider (keep it in the host dashboard, not Git).
DB_SSL_CA=

# --- Authentication (Phase 5) ---------------------------------------------------------------------
# Generate a unique random secret locally. Use at least 32 characters; never commit the real value.
# PowerShell example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Approved access-token lifetime and token validation identifiers.
JWT_EXPIRES_IN=15m
JWT_ISSUER=book-my-seat
JWT_AUDIENCE=book-my-seat-client
