# Copy this file to ".env" and adjust. ".env" is ignored by Git and must never be committed.
NODE_ENV=development
PORT=3000

# --- MySQL (Phase 4) -------------------------------------------------------------------------------
# Use 127.0.0.1 (not "localhost"): it avoids IPv6 lookup problems on Windows.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_my_seat
# Use the dedicated least-privilege user "bms_app" (see database/create_app_user.sql). Never use root.
DB_USER=bms_app
# Put the password you chose for bms_app here, in your own ".env" file ONLY. Never in this example file.
# If it contains a # character, wrap it in double quotes, for example:  DB_PASSWORD="my#password"
DB_PASSWORD=
# Maximum number of MySQL connections the pool may open (1 to 100).
DB_CONNECTION_LIMIT=10

# Added in later phases (do not fill in yet):
# JWT_SECRET=
